# Django Core Settings
DEBUG=False
SECRET_KEY=your-django-production-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,insightdocs.in,www.insightdocs.in,.railway.app
CSRF_TRUSTED_ORIGINS=https://insightdocs.in,https://www.insightdocs.in,http://localhost:8000,http://127.0.0.1:8000

# Security (Set to True on production HTTPS domain)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Database & Cache (PostgreSQL & Redis)
DATABASE_URL=postgres://user:password@host:port/dbname
REDIS_URL=redis://default:password@host:port

# Static Files
DJANGO_COLLECTSTATIC=1

# Email Service (Resend / SMTP)
RESEND_API_KEY=your_resend_api_key_here
DEFAULT_FROM_EMAIL=no.reply.authsystem@gmail.com
EMAIL_HOST_USER=no.reply.authsystem@gmail.com
EMAIL_HOST_PASSWORD=your_email_host_app_password

# Google Gemini API
GOOGLE_API_KEY=your_google_gemini_api_key

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# LLM Gateway (AgentRouter / DeepSeek v4 Flash for Pro & Industry)
ANTHROPIC_AUTH_TOKEN=your_agentrouter_token
ANTHROPIC_BASE_URL=https://agentrouter.org
CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
ANTHROPIC_MODEL=deepseek-v4-flash

